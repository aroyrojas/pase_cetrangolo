rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function mail() { return request.auth.token.email.lower(); }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(mail())).data; }
    function aprobado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/usuarios/$(mail()))
        && perfil().estado == 'aprobado';
    }
    function admin() { return aprobado() && perfil().rol == 'admin'; }

    // Solicitudes de acceso y permisos
    match /usuarios/{id} {
      allow read: if request.auth != null && (id == mail() || admin());
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && id == mail()
        && request.resource.data.keys().hasOnly(['email','nombre','estado','rol','creado'])
        && request.resource.data.email == mail()
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.rol == 'usuario';
      allow update, delete: if admin();
    }

    // Pacientes: solo usuarios aprobados
    match /pacientes/{id} {
      allow read, create, update: if aprobado();
      allow delete: if admin();
    }
  }
}
